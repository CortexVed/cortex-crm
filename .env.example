# ============================================================
# Cortex CRM — variables de entorno (copia a .env para desarrollo)
# NUNCA subas valores reales al repositorio.
# ============================================================

# --- Proceso ---
NODE_ENV=development            # development | test | production
PROCESS_ROLE=all                # web | worker | all | ci (en desarrollo: all; ci = health check del servicio de CI)
PORT=3000
LOG_LEVEL=info

# --- Base de datos ---
# En producción (Railway): DATABASE_URL=${{Postgres.DATABASE_URL}} (red privada).
# En desarrollo, si se omite, se usa PostgreSQL embebido (PGlite) en .data/pglite.
DATABASE_URL=
DB_POOL_MAX=15

# --- Seguridad ---
# Obligatoria en producción: 32 bytes aleatorios en base64 o cualquier secreto aleatorio de 32+ caracteres
# (la plantilla de Railway la genera). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Cambiarla invalida las API keys de IA y credenciales de canales ya guardadas.
APP_ENCRYPTION_KEY=
APP_URL=http://localhost:5173   # URL pública (enlaces de correo, comprobación de origen, webhooks); en Railway, por defecto el dominio público
ALLOW_SIGNUP=true               # registro público de nuevas organizaciones
CLIENT_IP_HEADER=               # cabecera con la IP real del cliente; en Railway se usa x-real-ip automáticamente ('none' la desactiva)
# Administración de plataforma: nunca se concede al registrarse en producción. Vías: el token de instalación
# (Ajustes › Mi cuenta, solo mientras no haya ninguna) o la CLI dentro del contenedor
# (node dist/server/cli.js grant-platform-admin <email>). Fuera de producción lo es el primer usuario.
PLATFORM_ADMIN_SETUP_TOKEN=     # secreto aleatorio de 32+ caracteres (opcional)

# --- Correo transaccional (recuperación de contraseña, verificación, invitaciones) ---
RESEND_API_KEY=
EMAIL_FROM=                     # p. ej. "Cortex CRM <no-reply@tudominio.com>"

# --- Claves LLM de plataforma (opcionales) ---
# Cada organización configura sus propias claves desde Ajustes › Proveedores de IA (cifradas).
# Estas solo se usan si ALLOW_PLATFORM_LLM_KEYS=true.
ALLOW_PLATFORM_LLM_KEYS=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
AI_MAX_REQUESTS_PER_HOUR=60

# Los scripts que EVOLVE AI ENGINE genera para cada organización se ejecutan en el sandbox
# integrado (QuickJS/WebAssembly): no necesitan repositorio ni credenciales externas.

# --- Motor de código fuente (opcional; docs/CODE_ENGINE.md) ---
# Solo en el Worker de Railway. Railway define RAILWAY_PROJECT_ID, RAILWAY_ENVIRONMENT_ID y RAILWAY_SERVICE_ID;
# la plantilla añade estas dos referencias. El token de proyecto de Railway NO va aquí: se pega en
# Código fuente › Configuración y se guarda cifrado.
CORTEX_SERVICE_ID=              # ${{Cortex.RAILWAY_SERVICE_ID}} (servicio web al que se despliega)
CI_SERVICE_ID=                  # ${{CI.RAILWAY_SERVICE_ID}} (servicio vacío en el que se prueba cada cambio)

# --- Límites ---
MAX_UPLOAD_MB=10
