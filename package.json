{
  "name": "cortex-crm",
  "version": "0.1.0",
  "description": "Cortex CRM — CRM autónomo, evolutivo y multi-LLM",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild server/src/index.ts server/src/cli.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --outdir=dist/server",
    "cli": "node dist/server/cli.js",
    "start": "node --enable-source-maps dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:sync": "node scripts/i18n.mjs sync"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "quickjs-emscripten-core": "0.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.108.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
